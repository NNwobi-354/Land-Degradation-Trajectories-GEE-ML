/**
 * CHAPTER 1: STUDY AREA AND TEMPORAL PARAMETERS
 * We define the ROI (Region of Interest) and the standardized 26-year window.
 * Starting in 2000 ensures that GLDAS 2.1 (NASA) data is fully available 
 * for all pixels, eliminating "No-Data" gaps found in 1990s records.
 */
var naijaROI = ee.FeatureCollection("projects/disaster-management-474719/assets/NAIJA_ROI");
var kalmykROI = ee.FeatureCollection("projects/disaster-management-474719/assets/Kalmykia_ROI");
var acledTable = ee.FeatureCollection("projects/disaster-management-474719/assets/number_of_political_violence_events_by_country-year_as-of-03Apr2026");

var region = naijaROI; // Switch to "kalmykROI"
var countryName = "Nigeria"; // Switch the to "Russia"
var startYear = 2000;
var endYear = 2025; 

/**
 * CHAPTER 2: RADIOMETRIC AND PHYSICAL CALIBRATION FACTORS
 * These constants convert raw satellite fluxes (per second) into 
 * standard annual units (mm/year and Celsius) for statistical validity.
 */
var SEC_IN_YEAR = 31536000; // Multiplier for Rain/Evap flux (kg/m2/s to mm/yr)
var W_TO_MM_DAY = 0.035;   // Conversion for PotEvap (Watts to mm/day)

var makeSafe = function(img, bandName) {
  var hasBands = img.bandNames().size().gt(0);
  var out = ee.Image(ee.Algorithms.If(hasBands, img.select([0]), ee.Image.constant(0)));
  return out.rename(bandName).clip(region).float();
};

/**
 * CHAPTER 3: INTEGRATED DATA STACKING (13 VARIABLES)
 * This loop iterates through each year, scales the data, and appends it to a 
 * single multi-band image cube.
 */
var finalExportImage = ee.Image([]);

for (var y = startYear; y <= endYear; y++) {
  var yearStr = ee.String(ee.Number(y).toInt());
  
  // -- 1. Vegetation Health (Landsat 30m NDVI) --
  var lCol = (y < 2013) ? ee.ImageCollection("LANDSAT/LT05/C02/T1_L2").merge(ee.ImageCollection("LANDSAT/LE07/C02/T1_L2")) : 
                          ee.ImageCollection("LANDSAT/LC08/C02/T1_L2").merge(ee.ImageCollection("LANDSAT/LC09/C02/T1_L2"));
  var ndvi = makeSafe(lCol.filterBounds(region).filter(ee.Filter.calendarRange(y, y, 'year'))
    .map(function(img){
      return img.updateMask(img.select('QA_PIXEL').bitwiseAnd(1 << 3).or(img.select('QA_PIXEL').bitwiseAnd(1 << 4)).eq(0))
                .normalizedDifference(['SR_B4', 'SR_B3']);
    }).max(), ee.String('NDVI_').cat(yearStr));

  // -- GLDAS 2.1 Physics Engine --
  var gldas = ee.ImageCollection("NASA/GLDAS/V021/NOAH/G025/T3H").filter(ee.Filter.calendarRange(y, y, 'year'));

  // 2. Albedo (Reflectivity - Decimal)
  var albedo = makeSafe(gldas.select('Albedo_inst').mean().multiply(0.01), ee.String('Albedo_').cat(yearStr));
  // 3. Rain (Total Precipitation - mm)
  var rain = makeSafe(gldas.select('Rainf_f_tavg').mean().multiply(SEC_IN_YEAR), ee.String('Rain_mm_').cat(yearStr));
  // 4. Temp (Air Temperature - Celsius)
  var temp = makeSafe(gldas.select('Tair_f_inst').mean().subtract(273.15), ee.String('Temp_C_').cat(yearStr));
  // 5. Evap (Actual Evapotranspiration - mm)
  var evap = makeSafe(gldas.select('Evap_tavg').mean().multiply(SEC_IN_YEAR), ee.String('Evap_mm_').cat(yearStr));
  // 6. PET (Potential Evapotranspiration - mm)
  var pet = makeSafe(gldas.select('PotEvap_tavg').mean().multiply(W_TO_MM_DAY).multiply(365), ee.String('PET_mm_').cat(yearStr));
  // 7. Soil Moisture (Root Zone - mm)
  var soilM = makeSafe(gldas.select('RootMoist_inst').mean(), ee.String('SoilM_mm_').cat(yearStr));
  // 8. Sensible Heat (Energy Flux - W/m2)
  var sHeat = makeSafe(gldas.select('Qh_tavg').mean(), ee.String('SensHeat_Wm2_').cat(yearStr));
  // 9. Surface Runoff (Overland flow - mm)
  var runoff = makeSafe(gldas.select('Qs_acc').mean(), ee.String('Runoff_mm_').cat(yearStr));
  // 10. Specific Humidity (Air Moisture)
  var humid = makeSafe(gldas.select('Qair_f_inst').mean(), ee.String('Humidity_').cat(yearStr));
  // 11. Wind Speed (m/s)
  var wind = makeSafe(gldas.select('Wind_f_inst').mean(), ee.String('Wind_ms_').cat(yearStr));

  // -- 12. Human Impact (ACLED Conflict Count) --
  var conflictCount = acledTable.filter(ee.Filter.eq('COUNTRY', countryName)).filter(ee.Filter.eq('YEAR', y)).aggregate_first('EVENTS');
  var conflictImg = ee.Image.constant(ee.Number(ee.Algorithms.If(conflictCount, conflictCount, 0)))
    .rename(ee.String('Conflict_').cat(yearStr)).clip(region);

  finalExportImage = finalExportImage.addBands([ndvi, albedo, rain, temp, evap, pet, soilM, sHeat, runoff, humid, wind, conflictImg]);
}

/**
 * CHAPTER 4: GRID GENERATION
 * We create a 5.5km fishnet grid across the ROI. This spatial resolution 
 * provides a balance between local detail and the coarser resolution 
 * of the GLDAS climate model (approx. 27km).
 */
var grid = region.geometry().coveringGrid(ee.Projection('EPSG:4326').scale(0.05, 0.05));

/**
 * CHAPTER 5: DATA EXTRACTION
 * The sampleRegions function extracts the value for all 13 variables 
 * at every grid point for every year (2000-2025).
 */
var exportTable = finalExportImage.sampleRegions({
  collection: grid,
  properties: [],
  scale: 27830, // Optimized to match GLDAS sensor footprint
  geometries: true
});

/**
 * CHAPTER 6: EXPORT
 * The final CSV is saved to Google Drive. This file is ready for 
 * Mann-Kendall and TSS-RESTREND analysis without further cleaning.
 */
Export.table.toDrive({
  collection: exportTable,
  description: countryName + '_Master_Uniform_2000_2025',
  fileFormat: 'CSV'
});
